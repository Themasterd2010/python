start

    //intialiaze
    current_time = device time


    //input
    output "please input your recievers name"
    input reciever_name
    output "please insert text message"
    input message_text
    output "when would you like to send this message?"
    input time_to_send


    //processing
    text_message = "Hello" + reciever_name + message_text
    wait time = time_to_send - current_time


    //input
    output "Is this what you want to send? " + text_message " (y/n)"
    input send

    //processing
    if send = y
    continue

    else
    restart process

    //output
    wait (wait time)
    output "text_message"

stop